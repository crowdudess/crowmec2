{
  "name": "nestguard",
  "productName": "Nestguard",
  "version": "2.75.8",
  "description": "A roguelike where a crow defends its nest. A game by crowdude.",
  "author": "crowdude",
  "repository": "github:crowdudess/crowmec2",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-game": "node wrap.js",
    "start": "npm run prepare-game && electron .",
    "dist": "npm run prepare-game && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.nestguard.game",
    "productName": "Nestguard",
    "artifactName": "Nestguard-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "game.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "publish": null
  }
}
